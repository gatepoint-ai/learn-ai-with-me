# =============================================================================
# Argus -- local configuration template
#
#   cp .env.example .env    then set ONE llm key (see LLM section)
#
# Everything here has a working default except the LLM key. The stack starts and
# serves dashboards with no key at all; only the Analyst service needs one.
# =============================================================================

# --- deployment target -------------------------------------------------------
DEPLOY_TARGET=dev
LOG_LEVEL=INFO
LOG_JSON=true

# --- ClickHouse (analytics) --------------------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=dev_password
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_SECURE=false

# --- Postgres (pulse / sentry / analyst databases) --------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=argus
POSTGRES_PASSWORD=dev_password

# --- Codex vector store (separate instance) ---------------------------------
CODEX_HOST=codex-db
CODEX_PORT=5432
CODEX_USER=argus
CODEX_PASSWORD=dev_password
CODEX_DATABASE=codex

# --- Valkey cache -----------------------------------------------------------
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_DB=0
CACHE_ENABLED=true

# --- service discovery ------------------------------------------------------
PRISM_URL=http://prism:8000
PULSE_URL=http://pulse:8000
SENTRY_URL=http://sentry:8000
CODEX_URL=http://codex:8000

# --- config location (mounted read-only into each service) ------------------
CONFIG_DIR=/config

# =============================================================================
# LLM -- pick ONE block below and set its key
#
# Two provider implementations cover roughly ten backends, because almost every
# free LLM host speaks the OpenAI chat-completions wire format including tool
# calling. Switching backend is a base_url + model change, not a code change.
#
# See docs/LLM-PROVIDERS.md for the full matrix and tool-calling quality notes.
# =============================================================================

LLM_PROVIDER=openai_compat

# --- Groq (default: free, no credit card, fast, native tool calling) --------
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_TOOL_CALLING=native
# Used when the primary model is rate limited -- free tiers meter each model
# separately, so a second model is a second quota.
OPENAI_FALLBACK_MODEL=qwen/qwen3.8-27b

# --- alternatives: uncomment one, comment the Groq block above --------------
#
# OpenRouter (one key, many models; append :free for the free tier)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=deepseek/deepseek-chat-v3.1:free
#
# Cerebras (free tier, very fast)
# OPENAI_BASE_URL=https://api.cerebras.ai/v1
# OPENAI_MODEL=llama-3.3-70b
#
# Gemini via its OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# OPENAI_MODEL=gemini-2.5-flash
#
# Ollama on the host -- fully offline, no key. Set tool_calling=weak so the
# Analyst uses constrained mode; small models are unreliable in a free-form
# multi-step tool loop.
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_MODEL=qwen3:8b
# OPENAI_API_KEY=ollama
# OPENAI_TOOL_CALLING=weak

# --- Claude (optional, best tool-use quality; not free) --------------------
# LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- agent loop bounds ------------------------------------------------------
# Caps tool round-trips per question so a confused model cannot spend a free
# tier allowance in one conversation.
MAX_TOOL_ITERATIONS=8
REQUEST_TIMEOUT=120

# =============================================================================
# Embeddings -- deliberately independent of the chat provider.
#
# Groq has no embeddings endpoint at all, so retrieval cannot piggyback on the
# default chat backend. Local ONNX inference needs no key and no network.
# =============================================================================

EMBEDDING_PROVIDER=local_fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# For a hosted embeddings endpoint instead:
# EMBEDDING_PROVIDER=openai_compat
# EMBEDDINGS_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# EMBEDDINGS_API_KEY=
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIM=768

# --- seeding ----------------------------------------------------------------
# Days of synthetic history. Minimum 14 so planted faults have baseline history.
SEED_DAYS=30

# --- deck (dashboard) -------------------------------------------------------
DECK_PORT=3000
DECK_SESSION_SECRET=change-me-in-any-shared-environment
